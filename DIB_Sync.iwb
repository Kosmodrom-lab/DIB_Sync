    FLOAT gwW2[24], gwAnX[24], gwAnY[24]

    ' DEMOSCENE HAIKU GENERATOR
    STRING g_HaikuLine1, g_HaikuLine2, g_HaikuLine3
	INT g_HaikuGenerated = 0

    INT numTechAd, numTechNouns, numTechVerbs, numTechPreps
    STRING techAd[60, 20]
    STRING techNoun[60, 20]
    STRING techVerb[60, 20]
    STRING techPrep[40, 20]

    ' Plasma Generatot
    POINTER g_asmPixel
    INT g_asmColor
    INT g_asmPitch
    ' Plasma textures generator arrays
    POINTER g_pDistBuffer = 0
    POINTER g_pAngleBuffer = 0
    INT fsin1[4096]
    INT fsin2[4096]
    INT fsin3[4096]
    INT coloop[256]
    INT tunnel_texture[16384]

    ' Declare global Hyperstars arrays at module scope
    FLOAT g_starX[501]
    FLOAT g_starY[501]
    FLOAT g_starZ[501]
    INT g_hyperStarsInit = 0
    INT g_warpSpeedActive = 0
    INT g_stL, g_stT, g_stR, g_stB, g_stF, g_stInc
    FLOAT g_shipX[11], g_shipY[11], g_shipZ[11]
    INT g_shipSX[11], g_shipSY[11], g_shipEA[14], g_shipEB[14]
    INT g_shipInit = 0



    ' --- 3D VECTOR SCROLLER ENGINE GLOBALS ---
    FLOAT fontGridX[3, 3, 28]
    FLOAT fontGridY[3, 3, 28]
    FLOAT fontGridZ[3, 3, 28]
    INT projX1[3, 3]
    INT projY1[3, 3]
    INT letterStruct[20, 65]
    STRING scrollText
    INT scrollIndex
