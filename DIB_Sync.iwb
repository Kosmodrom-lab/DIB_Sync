CONST SWP_NOSIZE = 1

' --- WIN32 RESOURCE APIS ---
DECLARE IMPORT, API_LoadResource ALIAS "LoadResource"(hModule:INT, hResInfo:INT), INT

' --- MEMORY FILE TRACKING STRUCTURE ---
TYPE tMEMFILE
    DEF length:INT
    DEF pos:INT
    DEF pdata:POINTER
ENDTYPE

TYPE BITMAPINFO
    DEF biSize:INT
    DEF biWidth:INT
    DEF biHeight:INT
    DEF biPlanes:WORD
    DEF biBitCount:WORD
    DEF biCompression:INT
    DEF biSizeImage:INT
    DEF biXPelsPerMeter:INT
    DEF biYPelsPerMeter:INT
    DEF biClrUsed:INT
    DEF biClrImportant:INT
ENDTYPE

' --- AMIGA FLY-IN OUTRO GLOBALS ---
TYPE FLY_LETTER
    DEF active:INT
    DEF charCode:INT
    DEF currentX:FLOAT
    DEF currentY:FLOAT
    DEF targetX:FLOAT
    DEF targetY:FLOAT
    DEF vx:FLOAT
    DEF vy:FLOAT
    DEF arrived:INT
ENDTYPE

' --- GLOBAL DIALOG & RESOLUTION VARIABLES ---
PROJECTGLOBAL "on"
    INT g_screenWidth
    INT g_screenHeight
    INT g_isFullScreen
    INT g_winW, g_winH                       ' window client size, or the screen size in fullscreen
    INT g_dstX, g_dstY, g_dstW, g_dstH       ' destination rectangle of the blit
    INT g_needScale = 0
    INT g_letterbox = 1                      ' 1 = keep aspect (black bars), 0 = fill the whole window/screen
    POINTER g_pResMemData
    INT g_nResMemSize
    INT g_pMiniFmodSong
    INT myMusicHandler
    ' --- AUDIO PULSE ENGINE GLOBALS ---
    INT g_lastRow = -1
    FLOAT g_beatPulse = 0.0
    FLOAT g_bassEnvelope = 0.0
PROJECTGLOBAL "off"

