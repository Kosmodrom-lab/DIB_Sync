    FLOAT phase, rot, grow
    INT starX[150], starY[150], starZ[150]
    FLOAT starDX[150]
    FLOAT cubeX[8], cubeY[8], cubeZ[8]
    FLOAT rotX, rotY, rotZ
    INT effectColors[12]
    INT sinTable[256], cosTable[256]
    INT copperIntensityLUT[21]
    INT fireworkState[3]
    INT fireworkX[3], fireworkY[3], partLife[3]
    FLOAT partX[3, 30], partY[3, 30], partVX[3, 30], partVY[3, 30]
    BITMAPINFO bmpInfo
    INT hMemDC, hMemBmp, hOldBmp
    POINTER pPixelBuffer, pCopperBuffer
    INT fontData[63, 48]
    STRING effectTechSpecs[22], effectNames[22]
    INT g_overlayEpoch = 0                      ' +1 every time the effect changes (automatically or with SPACE)
    INT g_gwDot

    ' Real Gravity Web
