    INT g_outroLetterCount
    INT g_outroPageIdx
    INT g_outroState
    FLOAT g_outroStateTimer
    INT g_nextLetterLaunchIdx
    STRING outroPages[3, 3]

    POINTER g_pFireBuffer
    INT firePalette[256]

    POINTER g_pWaveBuffer1
    POINTER g_pWaveBuffer2
    INT g_activeWaveBuf
    FLOAT g_waveTransformTimer

    INT g_turboMode

