    INT g_sw_BobArray16[256]
    UINT g_sw_Palette[4000]

    ' --- 3D MESH STORAGE ---
    INT g_sw_MeshPoints
    INT g_sw_MeshFaces
    double g_sw_Vx[20], g_sw_Vy[20], g_sw_Vz[20]
    INT g_sw_Vtx[20], g_sw_Vty[20], g_sw_Vtz[20]
    INT g_sw_Vf1[30], g_sw_Vf2[30], g_sw_Vf3[30], g_sw_Vf4[30]
    INT g_sw_Vr[30], g_sw_Vg[30], g_sw_Vb[30]
    double g_sw_Vxr, g_sw_Vyr, g_sw_Vzr

    STRING haikuLine1[8]
    STRING haikuLine2[8]
    STRING haikuLine3[8]
    INT currentLine1Idx, currentLine2Idx, currentLine3Idx

    INT g_tvSeed = 0x2545F491          ' xorshift32 state, must never be 0
    INT g_tvBias = 0                   ' brightness added by the beat

    ' --- CAROUSEL CROSS-FADE TRANSITION GLOBALS ---
    POINTER pTransitionBuffer = NULL
    INT g_isTransitioning = 0
    INT g_transitionFrame = 0
    CONST TRANSITION_DURATION = 30 ' Cross-fade length in frames (~0.5s at 60 FPS)

    ' Post Processing
    INT hPostDC, hPostBmp, hOldPostBmp
    POINTER pPostBuffer
    INT g_postFX = 1
    INT g_pfChunks, g_pfLastRow, g_pfShiftBytes, g_pfFlash, g_pfDark
PROJECTGLOBAL "off"

' --- MAIN INITIALIZATION BLOCK ---
g_screenWidth = 800
g_screenHeight = 600
g_isFullScreen = 0
g_pResMemData = NULL
g_nResMemSize = 0
g_pMiniFmodSong = 0
myMusicHandler = 0
g_pCheckerBuffer = NULL
g_outroLetterCount = 0
g_outroPageIdx = 0
g_outroState = 0
g_outroStateTimer = 0.0
g_nextLetterLaunchIdx = 0
g_activeWaveBuf = 0
g_waveTransformTimer = 0.0
g_turboMode = 0

$MAIN

InitEffectColors()
InitVectorFontTable()

IF ShowResolutionDialog() = 1 THEN

    INT winFlags

    IF g_isFullScreen THEN
        winFlags = @NOCAPTION | @NOAUTODRAW | @TOPMOST
    ELSE
        winFlags = @CAPTION | @SYSMENU | @MINBOX | @NOAUTODRAW
    ENDIF

    IF OPENWINDOW(main_win, 0, 0, g_winW, g_winH, winFlags, 0, "DIB_Sync!", &Handler) THEN
		  SETICON main_win, 1
        
        IF g_isFullScreen = 0 THEN CENTERWINDOW main_win

        cx = g_screenWidth / 2
        cy = g_screenHeight / 2

        ' Register automatic LIFO cleanup handler on program startup
        ONEXIT(&FreeEngineBuffers, NULL)

        InitGraphics()
        InitCubeData()
        InitEffectResources()
        InitTechDictionary()
		  GenerateStrictHaiku() ' Pre-builds the first 5-7-5 poem before loop starts)
        InitEffectNames()
        InitRasterbarPhysics()
        InitMetaballsLUT()
        InitEffect(0)
        InitEffectNames()
        InitEffectTechSpecs()
        InitFireEngine()
        InitCheckerboardBitmap()
        InitVectorFontData()
        InitOutroPages()
        InitTunnelEngine(g_screenWidth, g_screenHeight)
        SW_InitEngine()

        IF InitAndPlayAudioFromResource(1000) = 0 THEN
            MESSAGEBOX(0, "Problem initializing audio from resource!", "Warning")
        ELSE
            myMusicHandler = g_pMiniFmodSong
        ENDIF

        INT lastTick, currentTick, frameDelay
        frameDelay = 16
        lastTick = timeGetTime()

        WHILE main_win <> 0
            WAIT 1

            IF g_turboMode = 1 THEN
                Sleep(0)
                DrawBuffered()
            ELSE
                currentTick = timeGetTime()
                IF (currentTick - lastTick) >= frameDelay THEN
                    lastTick = currentTick
                    DrawBuffered()
                ELSE
                    Sleep(1)
                ENDIF
            ENDIF
        ENDWHILE

    ENDIF

ENDIF

END

' internal render size = the window size, but never more than 800x600
SUB SetRenderSize()
    g_screenWidth  = g_winW
    g_screenHeight = g_winH
    IF g_screenWidth > RENDER_MAX_W OR g_screenHeight > RENDER_MAX_H THEN
        g_screenWidth  = RENDER_MAX_W
        g_screenHeight = RENDER_MAX_H
    ENDIF
    screenW = g_screenWidth
    screenH = g_screenHeight
ENDSUB

' destination rectangle (call after SetRenderSize and after the window exists)
SUB ComputeBlitRect()
    g_dstX = 0
    g_dstY = 0
    g_dstW = g_winW
    g_dstH = g_winH
    IF g_letterbox = 1 THEN
        IF g_winW * screenH > g_winH * screenW THEN       ' window is wider than the render aspect
            g_dstW = (g_winH * screenW) / screenH
            g_dstX = (g_winW - g_dstW) / 2
        ELSE
            g_dstH = (g_winW * screenH) / screenW
            g_dstY = (g_winH - g_dstH) / 2
        ENDIF
    ENDIF
    IF g_dstW = screenW AND g_dstH = screenH AND g_dstX = 0 AND g_dstY = 0 THEN
        g_needScale = 0
    ELSE
        g_needScale = 1
    ENDIF
ENDSUB

SUB FreeEngineBuffers(pParam AS POINTER), INT
    ' 1. Halt audio hardware stream
    StopAndFreeAudio()

    ' 2. Release Win32 Device Contexts
    IF hMemDC <> 0 THEN
        SelectObject(hMemDC, hOldBmp)
        DeleteObject(hMemBmp)
        DeleteDC(hMemDC)
        hMemDC = 0
    ENDIF

   IF hPostDC <> 0 THEN
       SelectObject(hPostDC, hOldPostBmp)
       DeleteObject(hPostBmp)
       DeleteDC(hPostDC)
       hPostDC = 0
   ENDIF

    IF hWindowDC <> 0 THEN 
        ReleaseDC(main_win.hwnd, hWindowDC)
        hWindowDC = 0
    ENDIF

    ' 3. Free All Dynamically Allocated Pixel Buffers
    IF g_pHyperStarsLayer <> NULL THEN FREEMEM g_pHyperStarsLayer : g_pHyperStarsLayer = NULL
    IF pCopperBuffer      <> NULL THEN FREEMEM pCopperBuffer      : pCopperBuffer = NULL
    IF pTrailBuffer       <> NULL THEN FREEMEM pTrailBuffer       : pTrailBuffer = NULL
    IF g_pCheckerBuffer   <> NULL THEN FREEMEM g_pCheckerBuffer   : g_pCheckerBuffer = NULL
    IF g_pFireBuffer      <> NULL THEN FREEMEM g_pFireBuffer      : g_pFireBuffer = NULL
    IF g_pWaveBuffer1     <> NULL THEN FREEMEM g_pWaveBuffer1     : g_pWaveBuffer1 = NULL
    IF g_pWaveBuffer2     <> NULL THEN FREEMEM g_pWaveBuffer2     : g_pWaveBuffer2 = NULL
    IF g_pTextLayer       <> NULL THEN FREEMEM g_pTextLayer       : g_pTextLayer = NULL
    IF pTransitionBuffer  <> NULL THEN FREEMEM pTransitionBuffer  : pTransitionBuffer = NULL

RETURN 0
ENDSUB

' --- DIALOG SHOW ROUTINE ---
SUB ShowResolutionDialog(), INT
    ' Extended height to 225 to fit separator and hotkey instructions neatly
    CREATEDIALOG dlgRes, 0, 0, 260, 225, @CAPTION | @SYSMENU, 0, "Select Screen Resolution", &ResDialogHandler
    
    ' Resolution Controls
    CONTROL dlgRes, @RADIOBUTTON, "Windowed 640 x 480",         20, 12, 200, 20, @GROUP | @TABSTOP, ID_RAD_640
    CONTROL dlgRes, @RADIOBUTTON, "Windowed 800 x 600",         20, 34, 200, 20, 0, ID_RAD_800
    CONTROL dlgRes, @RADIOBUTTON, "Windowed 1024 x 768",        20, 56, 200, 20, 0, ID_RAD_1024
    CONTROL dlgRes, @RADIOBUTTON, "Full Screen Mode",           20, 78, 200, 20, 0, ID_RAD_FULL
    
    ' Options
    CONTROL dlgRes, @CHECKBOX,    "Turbo Mode! (Uncapped FPS)", 20, 106, 220, 20, @TABSTOP, ID_CHK_TURBO
    
    ' Default Focused Start Button (0x0001 = BS_DEFPUSHBUTTON)
    CONTROL dlgRes, @BUTTON,      "Start Demo",                 70, 134, 120, 26, @TABSTOP | 0x0001, ID_BTN_OK
    
    ' Horizontal Separator Rule (0x1000 = SS_SUNKEN)
    CONTROL dlgRes, @STATIC,      "",                           15, 170, 230, 2,  0x1000, 9990
    
    ' Hotkey Instructions Footer (@CTEDITCENTER centers the text)
    CONTROL dlgRes, @STATIC,      "Press SPACE for next effect  |  ESC to exit", 10, 178, 240, 18, @CTEDITCENTER, 9991
    
    RETURN DOMODAL(dlgRes, 0)
ENDSUB

SUB ResDialogHandler(), INT
    SELECT @MESSAGE
        CASE @IDINITDIALOG
            g_winW = 800 : g_winH = 600
			SETICON dlgRes, 1
            CENTERWINDOW dlgRes
            SETSTATE dlgRes, ID_RAD_800, 1
			   ' Force input focus directly onto the Start button
            SETFOCUS dlgRes, ID_BTN_OK
        CASE @IDCONTROL
            SELECT @CONTROLID
                CASE ID_BTN_OK
                    IF GETSTATE(dlgRes, ID_RAD_640) = 1 THEN
                        g_winW = 640  : g_winH = 480  : g_isFullScreen = 0
                    ELSE IF GETSTATE(dlgRes, ID_RAD_800) = 1 THEN
                        g_winW = 800  : g_winH = 600  : g_isFullScreen = 0
                    ELSE IF GETSTATE(dlgRes, ID_RAD_1024) = 1 THEN
                        g_winW = 1024 : g_winH = 768  : g_isFullScreen = 0
                    ELSE IF GETSTATE(dlgRes, ID_RAD_FULL) = 1 THEN
                        g_winW = GetSystemMetrics(0) : g_winH = GetSystemMetrics(1)
                        g_isFullScreen = 1
                    ENDIF
                    SetRenderSize()
                    g_turboMode = GETSTATE(dlgRes, ID_CHK_TURBO)
                    CLOSEDIALOG dlgRes, 1
            ENDSELECT

        CASE @IDCLOSEWINDOW
            CLOSEDIALOG dlgRes, 0
    ENDSELECT
    RETURN 0
ENDSUB

SUB InitOutroPages()
    outroPages[0, 0] = "DEMOSCENE ENGINE 2026"
    outroPages[0, 1] = "PURE ASSEMBLY PIPELINE"
    outroPages[0, 2] = "60 FPS HYBRID ENGINE"

    outroPages[1, 0] = "CODE AND GRAPHICS"
    outroPages[1, 1] = "m0xX and Gemini"
    outroPages[1, 2] = "Music by Seablue"

    outroPages[2, 0] = ""
    outroPages[2, 1] = "Written in iwBasic"
    outroPages[2, 2] = ""

    g_outroPageIdx = 0
    LoadOutroPage(0)
ENDSUB

SUB LoadOutroPage(pageIdx:INT)
    INT lineIdx, i, charCode, startX, startY
    INT scaleFX, charSpacing, lineLen
    STRING lineStr
    POINTER pStr

    scaleFX = 85196
    charSpacing = (18 * scaleFX) >> 16
    g_outroLetterCount = 0

    FOR lineIdx = 0 TO 2
        lineStr = outroPages[pageIdx, lineIdx]
        lineLen = LEN(lineStr)
        
        IF lineLen > 0 THEN
            startX = (screenW / 2) - ((lineLen * charSpacing) / 2)
            startY = (screenH / 2) - 60 + (lineIdx * 35)
            pStr = &lineStr

            FOR i = 0 TO lineLen - 1
                charCode = *<CHAR>(pStr + i)

                IF charCode <> 32 AND g_outroLetterCount < 120 THEN
                    outroLetters[g_outroLetterCount].active    = 0
                    outroLetters[g_outroLetterCount].charCode = charCode
                    outroLetters[g_outroLetterCount].targetX   = FLOAT(startX + i * charSpacing)
                    outroLetters[g_outroLetterCount].targetY   = FLOAT(startY)
                    
                    outroLetters[g_outroLetterCount].currentX = FLOAT(startX + i * charSpacing + RAND(-40, 40))
                    outroLetters[g_outroLetterCount].currentY = FLOAT(screenH + 80)
                    
                    outroLetters[g_outroLetterCount].vx        = 0.0
                    outroLetters[g_outroLetterCount].vy        = -28.0
                    outroLetters[g_outroLetterCount].arrived   = 0

                    g_outroLetterCount = g_outroLetterCount + 1
                ENDIF
            NEXT i
        ENDIF
    NEXT lineIdx

    g_outroState = 0
    g_outroStateTimer = 0.0
    g_nextLetterLaunchIdx = 0
ENDSUB

SUB UpdateAndDrawFlyInOutroDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    INT i, charColor, scaleFX
    FLOAT dx, dy, dist
    scaleFX = 85196

    DrawScrollingCheckerboardDirect(pBuffer, screenW, screenH)
    IF g_outroLetterCount = 0 THEN InitOutroPages()

    g_outroStateTimer = g_outroStateTimer + 0.05

    IF g_outroState = 0 THEN
        IF g_nextLetterLaunchIdx < g_outroLetterCount AND (INT(g_outroStateTimer * 20.0) % 2 = 0) THEN
            outroLetters[g_nextLetterLaunchIdx].active = 1
            g_nextLetterLaunchIdx = g_nextLetterLaunchIdx + 1
        ENDIF

        INT allArrived = 1
        FOR i = 0 TO g_outroLetterCount - 1
            IF outroLetters[i].active = 1 AND outroLetters[i].arrived = 0 THEN
                allArrived = 0
                dx = outroLetters[i].targetX - outroLetters[i].currentX
                dy = outroLetters[i].targetY - outroLetters[i].currentY
                
                outroLetters[i].vx = outroLetters[i].vx * 0.78 + dx * 0.12
                outroLetters[i].vy = outroLetters[i].vy * 0.78 + dy * 0.12
                
                outroLetters[i].currentX = outroLetters[i].currentX + outroLetters[i].vx
                outroLetters[i].currentY = outroLetters[i].currentY + outroLetters[i].vy

                dist = SQRT(dx * dx + dy * dy)
                IF dist < 1.5 AND ABS(outroLetters[i].vy) < 1.0 THEN
                    outroLetters[i].currentX = outroLetters[i].targetX
                    outroLetters[i].currentY = outroLetters[i].targetY
                    outroLetters[i].arrived   = 1
                ENDIF
            ENDIF
        NEXT i

        IF g_nextLetterLaunchIdx >= g_outroLetterCount AND allArrived = 1 THEN
            g_outroState = 1
            g_outroStateTimer = 0.0
        ENDIF

    ELSE IF g_outroState = 1 THEN
        IF g_outroStateTimer >= 2.5 THEN
            g_outroState = 2
            g_outroStateTimer = 0.0
            
            FOR i = 0 TO g_outroLetterCount - 1
                outroLetters[i].vx = FLOAT(RAND(-4, 4))
                outroLetters[i].vy = FLOAT(RAND(2, 8))
            NEXT i
        ENDIF

    ELSE IF g_outroState = 2 THEN
        INT allOffScreen = 1
        FOR i = 0 TO g_outroLetterCount - 1
            outroLetters[i].vy = outroLetters[i].vy + 1.8
            outroLetters[i].currentX = outroLetters[i].currentX + outroLetters[i].vx
            outroLetters[i].currentY = outroLetters[i].currentY + outroLetters[i].vy

            IF outroLetters[i].currentY < (screenH + 50) THEN
                allOffScreen = 0
            ENDIF
        NEXT i

        IF allOffScreen = 1 THEN
            g_outroPageIdx = (g_outroPageIdx + 1) % 3
            LoadOutroPage(g_outroPageIdx)
        ENDIF
    ENDIF

    charColor = GetCycleColor(INT(phase * 40.0) & 255)

    FOR i = 0 TO g_outroLetterCount - 1
        IF outroLetters[i].active = 1 THEN
            DrawVectorCharShadow(pBuffer, screenW, screenH, _
                                 outroLetters[i].charCode, _
                                 INT(outroLetters[i].currentX) + 2, _
                                 INT(outroLetters[i].currentY) + 2, _
                                 scaleFX)

            DrawVectorCharDirect(pBuffer, screenW, screenH, _
                                 outroLetters[i].charCode, _
                                 INT(outroLetters[i].currentX), _
                                 INT(outroLetters[i].currentY), _
                                 scaleFX, charColor)
        ENDIF
    NEXT i
ENDSUB

SUB InitCubeData()
    cubeVerts[0] = -1.0 : cubeVerts[1] = -1.0 : cubeVerts[2] = -1.0
    cubeVerts[3] =  1.0 : cubeVerts[4] = -1.0 : cubeVerts[5] = -1.0
    cubeVerts[6] =  1.0 : cubeVerts[7] =  1.0 : cubeVerts[8] = -1.0
    cubeVerts[9] = -1.0 : cubeVerts[10] = 1.0 : cubeVerts[11] = -1.0
    cubeVerts[12] = -1.0 : cubeVerts[13] = -1.0 : cubeVerts[14] = 1.0
    cubeVerts[15] =  1.0 : cubeVerts[16] = -1.0 : cubeVerts[17] = 1.0
    cubeVerts[18] =  1.0 : cubeVerts[19] =  1.0 : cubeVerts[20] = 1.0
    cubeVerts[21] = -1.0 : cubeVerts[22] =  1.0 : cubeVerts[23] = 1.0

    cubeEdges[0] = 0 : cubeEdges[1] = 1
    cubeEdges[2] = 1 : cubeEdges[3] = 2
    cubeEdges[4] = 2 : cubeEdges[5] = 3
    cubeEdges[6] = 3 : cubeEdges[7] = 0
    cubeEdges[8] = 4 : cubeEdges[9] = 5
    cubeEdges[10] = 5 : cubeEdges[11] = 6
    cubeEdges[12] = 6 : cubeEdges[13] = 7
    cubeEdges[14] = 7 : cubeEdges[15] = 4
    cubeEdges[16] = 0 : cubeEdges[17] = 4
    cubeEdges[18] = 1 : cubeEdges[19] = 5
    cubeEdges[20] = 2 : cubeEdges[21] = 6
    cubeEdges[22] = 3 : cubeEdges[23] = 7
ENDSUB

SUB InitMetaballsLUT()
    INT dx, dy
    FLOAT distSq, force
    FOR dy = -191 TO 192
        FOR dx = -191 TO 192
            distSq = FLOAT(dx * dx + dy * dy)
            IF distSq < 90000.0 THEN
                force = 45000.0 / (distSq + 900.0)
                metaballLUT[dx + 191, dy + 191] = INT(force)
            ELSE
                metaballLUT[dx + 191, dy + 191] = 0
            ENDIF
        NEXT dx
    NEXT dy
ENDSUB

