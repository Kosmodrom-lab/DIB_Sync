SUB ApplyTrailDecaySSE2(pBuffer:POINTER, numPix:INT, decayFactor:INT)
    IF decayFactor < 0 THEN decayFactor = 0
    IF decayFactor > 255 THEN decayFactor = 255
    g_pAsmDst = pBuffer
    g_asmCount = numPix >> 2
    g_asmDecay = decayFactor
    g_asmPixelColor = 0xFF000000

    _asm
        push edi
        mov edi, [g_pAsmDst]
        mov ecx, [g_asmCount]

        test edi, edi
        jz decay_exit
        test ecx, ecx
        jz decay_exit

        mov eax, [g_asmDecay]
        movd xmm3, eax
        pshuflw xmm3, xmm3, 0
        punpcklqdq xmm3, xmm3         ; factor in all 8 words
        movd xmm5, [g_asmPixelColor]
        pshufd xmm5, xmm5, 0          ; alpha byte forced to 0xFF
        pxor xmm4, xmm4

    decay_loop:
        movdqu xmm0, [edi]
        movdqa xmm1, xmm0
        punpcklbw xmm0, xmm4          ; bytes -> words (low 2 pixels)
        punpckhbw xmm1, xmm4          ; (high 2 pixels)
        pmullw xmm0, xmm3
        pmullw xmm1, xmm3
        psrlw xmm0, 8
        psrlw xmm1, 8
        packuswb xmm0, xmm1
        por xmm0, xmm5
        movdqu [edi], xmm0
        add edi, 16
        dec ecx
        jnz decay_loop

    decay_exit:
        pop edi
    _endasm
ENDSUB

SUB InitFireEngine()
    INT i, r, g, b

    FOR i = 0 TO 255
        IF i < 64 THEN
            r = i * 4 : g = 0 : b = 0
        ELSE IF i < 128 THEN
            r = 255 : g = (i - 64) * 4 : b = 0
        ELSE IF i < 192 THEN
            r = 255 : g = 255 : b = (i - 128) * 4
        ELSE
            r = 255 : g = 255 : b = 255
        ENDIF
        firePalette[i] = 0xFF000000 | (r << 16) | (g << 8) | b
    NEXT i

    IF g_pFireBuffer <> NULL THEN FREEMEM g_pFireBuffer
    ALLOCMEM(g_pFireBuffer, screenW * (screenH + 4), 1)
    FastClearBuffer(g_pFireBuffer, screenW * (screenH + 4))
ENDSUB

SUB DrawFireEffectDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    IF g_pFireBuffer = NULL THEN
        InitFireEngine()
        IF g_pFireBuffer = NULL THEN RETURN
    ENDIF

    INT x, y
    INT heat, avgHeat, decay
    INT fireW, fireH
    POINTER pHeatBase, pPixel
    POINTER pRowBelow1, pRowBelow2, pRowAbove

    fireW = screenW
    fireH = screenH

    ' 1. SEED THE BOTTOM IGNITION LINE
    pHeatBase = g_pFireBuffer + ((fireH - 152) * fireW)
    FOR x = 44 TO (fireW - 48)
        IF RAND(0, 100) > 25 THEN
            *<CHAR>(pHeatBase + x) = RAND(190, 255)
        ELSE
            *<CHAR>(pHeatBase + x) = 0
        ENDIF
    NEXT x

    ' 2. SIMULATE HEAT PROPAGATION & CONVECTIVE COOLING
    ' Pre-calculate row pointers outside the X loop to avoid continuous additions
    FOR y = 152 TO (fireH - 153)
        pRowAbove   = g_pFireBuffer + ((y - 1) * fireW)
        pRowBelow1  = g_pFireBuffer + ((y + 1) * fireW)
        pRowBelow2  = g_pFireBuffer + ((y + 2) * fireW)

        FOR x = 45 TO (fireW - 45)
            ' Average neighbors below
            avgHeat = *<CHAR>(pRowBelow1 + x - 1) + _
                      *<CHAR>(pRowBelow1 + x) + _
                      *<CHAR>(pRowBelow1 + x + 1) + _
                      *<CHAR>(pRowBelow2 + x)

            avgHeat = avgHeat >> 2

            ' Fast pseudo-random decay (alternates between 0, 1, or 2 without calling RAND)
            decay = (x + y) & 1

            IF avgHeat > decay THEN
                avgHeat = avgHeat - decay
            ELSE
                avgHeat = 0
            ENDIF

            ' Store updated heat in row above
            *<CHAR>(pRowAbove + x) = avgHeat
        NEXT x
    NEXT y

    ' 3. PALETTE LOOKUP & 2x2 PIXEL BLOCK RASTERIZATION
    INT rowPitchBytes, nextRowOffsetBytes
    rowPitchBytes = fireW * 4
    nextRowOffsetBytes = rowPitchBytes

    FOR y = 154 TO (fireH - 156) STEP 2
        pHeatBase = g_pFireBuffer + (y * fireW + 44)
        pPixel    = pBuffer + ((y * fireW + 44) * 4)

        FOR x = 44 TO (fireW - 48) STEP 2
            heat = *<CHAR>pHeatBase

            IF heat > 4 THEN
                INT pixelColor = firePalette[heat]

                ' Fast 2x2 block blit to frame buffer
                *<INT>pPixel = pixelColor
                *<INT>(pPixel + 4) = pixelColor
                *<INT>(pPixel + nextRowOffsetBytes) = pixelColor
                *<INT>(pPixel + nextRowOffsetBytes + 4) = pixelColor
            ENDIF

            pHeatBase = pHeatBase + 2
            pPixel    = pPixel + 8
        NEXT x
    NEXT y
ENDSUB

SUB InitWaveBuffers()
    IF g_pWaveBuffer1 <> NULL THEN FREEMEM g_pWaveBuffer1
    IF g_pWaveBuffer2 <> NULL THEN FREEMEM g_pWaveBuffer2

    ALLOCMEM(g_pWaveBuffer1, screenW * screenH, 2)
    ALLOCMEM(g_pWaveBuffer2, screenW * screenH, 2)

    FastClearBuffer(g_pWaveBuffer1, screenW * screenH * 2)
    FastClearBuffer(g_pWaveBuffer2, screenW * screenH * 2)

    g_activeWaveBuf = 0
    g_waveTransformTimer = 0.0
ENDSUB

SUB InjectWaveDrop(pBuf:POINTER, bufW:INT, bufH:INT, dropX:INT, dropY:INT, radius:INT, force:INT)
    INT x, y, dx, dy, distSq, radSq
    POINTER pPtr

    radSq = radius * radius
    FOR dy = -radius TO radius
        y = dropY + dy
        IF y > 155 AND y < (bufH - 155) THEN
            FOR dx = -radius TO radius
                x = dropX + dx
                IF x > 45 AND x < (bufW - 45) THEN
                    distSq = dx * dx + dy * dy
                    IF distSq <= radSq THEN
                        pPtr = pBuf + ((y * bufW + x) * 2)
                        *<WORD>pPtr = force
                    ENDIF
                ENDIF
            NEXT dx
        ENDIF
    NEXT dy
ENDSUB

SUB ProcessWaveSimulation(pSrcBuf:POINTER, pDstBuf:POINTER, bufW:INT, bufH:INT)
    INT x, y, nVal
    POINTER pCurr, pDst
    
    FOR y = 152 TO (bufH - 152)
        pCurr = pSrcBuf + ((y * bufW + 45) * 2)
        pDst  = pDstBuf + ((y * bufW + 45) * 2)
        
        FOR x = 45 TO (bufW - 45)
            nVal = (*<WORD>(pCurr - 2) + *<WORD>(pCurr + 2) + *<WORD>(pCurr - bufW * 2) + *<WORD>(pCurr + bufW * 2)) >> 1
            nVal = nVal - *<WORD>pDst
            nVal = nVal - (nVal >> 5)
            
            IF nVal < 0 THEN nVal = 0
            IF nVal > 2048 THEN nVal = 2048
            
            *<WORD>pDst = nVal
            
            pCurr = pCurr + 2
            pDst  = pDst + 2
        NEXT x
    NEXT y
ENDSUB

SUB RenderWaveHeightMap(pHeightBuf:POINTER, pPixelBuf:POINTER, screenW:INT, screenH:INT, penColor:INT)
    INT x, y, waveHeight, colorIdx, finalColor
    POINTER pHeight, pPixel

    FOR y = 152 TO (screenH - 152) STEP 2
        pHeight = pHeightBuf + ((y * screenW + 45) * 2)
        pPixel  = pPixelBuf  + ((y * screenW + 45) * 4)

        FOR x = 45 TO (screenW - 45) STEP 2
            waveHeight = *<WORD>pHeight

            IF waveHeight > 8 THEN
                colorIdx = ((waveHeight >> 2) + INT(phase * 30.0)) & 255
                finalColor = GetCycleColor(colorIdx)

                *<INT>pPixel = finalColor
                *<INT>(pPixel + 4) = finalColor
                *<INT>(pPixel + (screenW * 4)) = finalColor
                *<INT>(pPixel + (screenW * 4) + 4) = finalColor
            ENDIF

            pHeight = pHeight + 4
            pPixel  = pPixel + 8
        NEXT x
    NEXT y
ENDSUB

SUB DrawDottedWormholeDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    INT ring, dot
    INT colorIdx, pixelColor, baseAngleIdx
    FLOAT radius, zDepth, speed, camX, camY
    FLOAT bendX, bendY
    INT ringCx, ringCy, intRadius
    INT dotX, dotY, angleIdx

    camX = SIN(phase * 1.2) * 20.0
    camY = COS(phase * 0.9) * 15.0
    
    ' --- BEAT PULSE MODULATION ---
    speed = phase * (18.0 + (g_beatPulse * 16.0))

    FOR ring = 0 TO 27
        zDepth = 260.0 - (FLOAT(ring * 9) + speed)
        
        WHILE zDepth < 10.0
            zDepth = zDepth + 250.0
        ENDWHILE
        WHILE zDepth > 260.0
            zDepth = zDepth - 250.0
        ENDWHILE

        radius = 18000.0 / zDepth
        intRadius = INT(radius)

        bendX = SIN((phase * 1.5) + (zDepth * 0.015)) * (zDepth * 0.35)
        bendY = COS((phase * 1.1) + (zDepth * 0.018)) * (zDepth * 0.25)

        ringCx = INT(FLOAT(screenW / 2) + camX + bendX)
        ringCy = INT(FLOAT(screenH / 2) + camY + bendY)
        
        baseAngleIdx = INT(((phase * 0.8) + (zDepth * 0.02)) * 40.7436) & 255
        colorIdx = (INT(zDepth * 0.8) + INT(phase * 45.0)) & 255
        pixelColor = GetCycleColor(colorIdx)

        FOR dot = 0 TO 31
            angleIdx = (baseAngleIdx + (dot * 8)) & 255
            
            dotX = ringCx + ((cosTable[angleIdx] * intRadius) >> 16)
            dotY = ringCy + ((sinTable[angleIdx] * intRadius) >> 16)

            IF dotX >= 44 AND (dotX + 3) < (screenW - 48) THEN
                IF dotY >= 156 AND (dotY + 3) < (screenH - 160) THEN
                    g_pAsmPixel = pBuffer + ((dotY * screenW + dotX) * 4)
                    g_asmPixelColor = pixelColor
                    g_asmCount = screenW * 4

                    _asm
                        push edi
                        mov edi, [g_pAsmPixel]
                        mov eax, [g_asmPixelColor]
                        mov edx, [g_asmCount]

                        mov [edi], eax
                        mov [edi+4], eax
                        mov [edi+8], eax
                        mov [edi+12], eax

                        add edi, edx
                        mov [edi], eax
                        mov [edi+4], eax
                        mov [edi+8], eax
                        mov [edi+12], eax

                        add edi, edx
                        mov [edi], eax
                        mov [edi+4], eax
                        mov [edi+8], eax
                        mov [edi+12], eax

                        add edi, edx
                        mov [edi], eax
                        mov [edi+4], eax
                        mov [edi+8], eax
                        mov [edi+12], eax

                        pop edi
                    _endasm
                ENDIF
            ENDIF
        NEXT dot
    NEXT ring
ENDSUB

SUB DrawMetaballsEffectDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    INT x, y, i
    INT sumForce, colorIdx, pixelColor
    INT mbXi[4], mbYi[4]

    mbXi[0] = INT((screenW / 2) + SIN(phase * 1.1) * 200.0)
    mbYi[0] = INT((screenH / 2) + COS(phase * 0.8) * 70.0)
    mbXi[1] = INT((screenW / 2) + COS(phase * 1.3) * 220.0)
    mbYi[1] = INT((screenH / 2) + SIN(phase * 1.0) * 80.0)
    mbXi[2] = INT((screenW / 2) + SIN(phase * 0.7 + 1.5) * 170.0)
    mbYi[2] = INT((screenH / 2) + COS(phase * 1.2 + 0.8) * 75.0)
    mbXi[3] = INT((screenW / 2) + COS(phase * 1.0 + 2.1) * 190.0)
    mbYi[3] = INT((screenH / 2) + SIN(phase * 1.5 + 1.2) * 65.0)

    FOR y = 156 TO (screenH - 160) STEP 4
        FOR x = 44 TO (screenW - 48) STEP 4
            sumForce = 0

            FOR i = 0 TO 3
                INT rX = x - mbXi[i] + 191
                INT rY = y - mbYi[i] + 191
                IF rX >= 0 AND rX < 384 AND rY >= 0 AND rY < 384 THEN
                    sumForce = sumForce + metaballLUT[rX, rY]
                ENDIF
            NEXT i

            IF sumForce >= 25 THEN
                colorIdx = (sumForce * 4 + INT(phase * 45.0)) & 255
                pixelColor = GetCycleColor(colorIdx)

                g_pAsmPixel = pBuffer + ((y * screenW + x) * 4)
                g_asmPixelColor = pixelColor
                g_asmCount = screenW * 4

                _asm
                    push edi
                    mov edi, [g_pAsmPixel]
                    mov eax, [g_asmPixelColor]
                    mov edx, [g_asmCount]

                    mov [edi], eax
                    mov [edi+4], eax
                    mov [edi+8], eax
                    mov [edi+12], eax

                    add edi, edx
                    mov [edi], eax
                    mov [edi+4], eax
                    mov [edi+8], eax
                    mov [edi+12], eax

                    add edi, edx
                    mov [edi], eax
                    mov [edi+4], eax
                    mov [edi+8], eax
                    mov [edi+12], eax

                    add edi, edx
                    mov [edi], eax
                    mov [edi+4], eax
                    mov [edi+8], eax
                    mov [edi+12], eax

                    pop edi
                _endasm
            ENDIF
        NEXT x
    NEXT y
ENDSUB

SUB DrawPlasmaEffectDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    IF pBuffer = NULL THEN RETURN

    INT x, y
    INT colorIdx, pixelColor, calcWave
    INT phaseOff1, phaseOff2, phaseOff3
    INT cosTableY, yRowOffset, pitchBytes


    phaseOff1 = INT(phase * 40.0) & 255
    phaseOff2 = INT(phase * 25.0) & 255
    phaseOff3 = INT(phase * 15.0) & 255

    pitchBytes = screenW * 4
    g_asmPitch = pitchBytes

    FOR y = 156 TO (screenH - 160) STEP 4
        cosTableY  = cosTable[(y + phaseOff2) & 255] >> 10
        yRowOffset = y * screenW

        FOR x = 44 TO (screenW - 48) STEP 4
            calcWave = (sinTable[(x + phaseOff1) & 255] >> 10) + _
                       cosTableY + _
                       (sinTable[(x + y + phaseOff3) & 255] >> 10)

            colorIdx = (calcWave + phaseOff1) & 255
            pixelColor = GetCycleColor(colorIdx)

            g_asmPixel = pBuffer + ((yRowOffset + x) * 4)
            g_asmColor = pixelColor

            _asm
                push edi
                push eax
                push edx

                mov edi, [g_asmPixel]
                mov eax, [g_asmColor]
                mov edx, [g_asmPitch]

                ; Row 0
                mov [edi], eax
                mov [edi+4], eax
                mov [edi+8], eax
                mov [edi+12], eax

                ; Row 1
                add edi, edx
                mov [edi], eax
                mov [edi+4], eax
                mov [edi+8], eax
                mov [edi+12], eax

                ; Row 2
                add edi, edx
                mov [edi], eax
                mov [edi+4], eax
                mov [edi+8], eax
                mov [edi+12], eax

                ; Row 3
                add edi, edx
                mov [edi], eax
                mov [edi+4], eax
                mov [edi+8], eax
                mov [edi+12], eax

                pop edx
                pop eax
                pop edi
            _endasm
        NEXT x
    NEXT y
ENDSUB

SUB DrawRasterbarsEffectDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    DEF i, j, y, barY:INT
    DEF offset, intensity, highlight:FLOAT
    DEF cr, cg, cb:INT
    INT baseR, baseG, baseB
    INT barColors[29]

    INT rPalette[6]
    INT gPalette[6]
    INT bPalette[6]

    rPalette[0] = 255: gPalette[0] = 200: bPalette[0] = 0
    rPalette[1] = 227: gPalette[1] = 40:  bPalette[1] = 40
    rPalette[2] = 40:  gPalette[2] = 210: bPalette[2] = 80
    rPalette[3] = 0:   gPalette[3] = 180: bPalette[3] = 255
    rPalette[4] = 230: gPalette[4] = 20:  bPalette[4] = 200
    rPalette[5] = 255: gPalette[5] = 100: bPalette[5] = 0

    FLOAT bounceAmp = 120.0

    FOR i = 0 TO 5
        offset = phase + (FLOAT(i) * 0.28)
        barY = (screenH / 2) + INT(SIN(offset) * bounceAmp)

        baseR = rPalette[i]
        baseG = gPalette[i]
        baseB = bPalette[i]

        FOR j = -14 TO 14
            intensity = 1.0 - (ABS(FLOAT(j)) / 14.5)
            IF intensity < 0.05 THEN intensity = 0.05
            intensity = intensity * intensity

            intensity = intensity * (1.0 + (g_beatPulse * 0.30))

            cr = INT(FLOAT(baseR) * intensity)
            cg = INT(FLOAT(baseG) * intensity)
            cb = INT(FLOAT(baseB) * intensity)

            highlight = 1.0 - (ABS(FLOAT(j)) / 8.0)
            IF highlight > 0.0 THEN
                highlight = highlight * highlight
                cr = cr + INT((255.0 - FLOAT(cr)) * highlight * 0.85)
                cg = cg + INT((255.0 - FLOAT(cg)) * highlight * 0.85)
                cb = cb + INT((255.0 - FLOAT(cb)) * highlight * 0.85)
            ENDIF

            IF ((j + 14) % 2) = 1 THEN
                cr = INT(FLOAT(cr) * 0.82) + 25
                cg = INT(FLOAT(cg) * 0.82) + 25
                cb = INT(FLOAT(cb) * 0.82) + 25
            ENDIF

            IF cr > 255 THEN cr = 255
            IF cg > 255 THEN cg = 255
            IF cb > 255 THEN cb = 255

            barColors[j + 14] = 0xFF000000 | (cr << 16) | (cg << 8) | cb
        NEXT j

        FOR j = -14 TO 14
            y = barY + j

            IF y >= 151 AND y < (screenH - 151) THEN
                g_pAsmPixel = pBuffer + (y * screenW * 4)
                g_asmLinePixelColor = barColors[j + 14]
                g_asmCount = screenW

                _asm
                    push edi
                    mov edi, [g_pAsmPixel]
                    mov eax, [g_asmLinePixelColor]
                    mov ecx, [g_asmCount]
                    rep stosd
                    pop edi
                _endasm
            ENDIF
        NEXT j
    NEXT i
ENDSUB

SUB UpdateAndDrawStarfieldDirect(pBuffer:POINTER, screenW:INT, screenH:INT)
    INT i, px, py, lineY
    POINTER pPixel

    g_pAsmPixel = pBuffer
    g_asmCount = 148 * screenW

    _asm
        push edi
        mov edi, [g_pAsmPixel]
        mov ecx, [g_asmCount]
        xor eax, eax
        rep stosd
        pop edi
    _endasm

    lineY = screenH - 147
    IF lineY >= 0 AND lineY < screenH THEN
        g_pAsmPixel = pBuffer + (lineY * screenW * 4)
        g_asmCount = 147 * screenW

        _asm
            push edi
            mov edi, [g_pAsmPixel]
            mov ecx, [g_asmCount]
            xor eax, eax
            rep stosd
            pop edi
        _endasm
    ENDIF

    FOR i = 0 TO 149
        IF i < 75 THEN
            starX[i] = starX[i] - INT(starDX[i])
            IF starX[i] < 0 THEN 
                starX[i] = screenW - 1
                starY[i] = RAND(1, 140)
            ENDIF
            px = starX[i]
            py = starY[i]
        ELSE
            starX[i] = starX[i] + INT(starDX[i])
            IF starX[i] >= screenW THEN 
                starX[i] = 0
                starY[i] = RAND(1, 140)
            ENDIF
            px = starX[i]
            py = (screenH - 146) + starY[i]
        ENDIF
        
        IF px >= 0 AND px < screenW AND py >= 0 AND py < screenH THEN
            pPixel = pBuffer + ((py * screenW + px) * 4)
            *<INT>pPixel = 0xFFFFFFFF
        ENDIF
    NEXT i

	 ' Top and bottom viewport thick yellow bars
    ' g_asmLinePixelColor = 0xFFFFFF00

    g_pAsmPixel = pBuffer + (148 * screenW * 4)
    g_asmCount = 3 * screenW
    _asm
        push edi
        mov edi, [g_pAsmPixel]
        mov eax, [g_asmLinePixelColor]
        mov ecx, [g_asmCount]
        rep stosd
        pop edi
    _endasm

    lineY = screenH - 150
    IF lineY >= 0 AND lineY < screenH THEN
        g_pAsmPixel = pBuffer + (lineY * screenW * 4)
        g_asmCount = 3 * screenW
        _asm
            push edi
            mov edi, [g_pAsmPixel]
            mov eax, [g_asmLinePixelColor]
            mov ecx, [g_asmCount]
            rep stosd
            pop edi
        _endasm
    ENDIF
ENDSUB

SUB DrawDottedSphereDirect(pBuffer:POINTER, screenW:INT, screenH:INT, penColor:INT)
    DEF i, qx, qy:INT
    INT centerX, leftX, rightX, sideOffset, screenX, screenY, colorIdx, pixelColor
    FLOAT u, v, x, y, z, xy, scale, projX, projY
    FLOAT rx1, ry1, rx2, ry2, rx3, ry3
    FLOAT tx, ty, tz
    POINTER pPixel

    ' Independent rotations for each sphere
    rotX = rotX + 0.03 : rotY = rotY + 0.04
    rx1 = rotX : ry1 = rotY
    rx2 = -rotX * 1.2 : ry2 = rotY * 1.5
    rx3 = rotX * 0.5 : ry3 = -rotY * 0.8

    sideOffset = (screenW * 35) / 100
    centerX = screenW / 2
    leftX   = centerX - sideOffset
    rightX  = centerX + sideOffset
    scale   = 110.0

    FOR i = 0 TO 99
        v = FLOAT(i) * 0.0314 : u = FLOAT(i) * 0.618
        tx = SIN(u) * COS(v) : ty = SIN(u) * SIN(v) : tz = COS(u)
        colorIdx = (i + INT(phase * 40.0)) % 256

        ' Left Sphere
        x = tx : y = ty : z = tz
        xy = y * COS(rx1) - z * SIN(rx1) : z = y * SIN(rx1) + z * COS(rx1) : y = xy
        xy = x * COS(ry1) + z * SIN(ry1) : z = -x * SIN(ry1) + z * COS(ry1) : x = xy
        projX = x * scale : projY = y * scale
        screenY = INT(projY) + (screenH / 2) : screenX = INT(projX) + leftX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor(colorIdx % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF

        ' Center Sphere
        x = tx : y = ty : z = tz
        xy = y * COS(rx2) - z * SIN(rx2) : z = y * SIN(rx2) + z * COS(rx2) : y = xy
        xy = x * COS(ry2) + z * SIN(ry2) : z = -x * SIN(ry2) + z * COS(ry2) : x = xy
        projX = x * scale : projY = y * scale
        screenY = INT(projY) + (screenH / 2) : screenX = INT(projX) + centerX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor((colorIdx + 85) % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF

        ' Right Sphere
        x = tx : y = ty : z = tz
        xy = y * COS(rx3) - z * SIN(rx3) : z = y * SIN(rx3) + z * COS(rx3) : y = xy
        xy = x * COS(ry3) + z * SIN(ry3) : z = -x * SIN(ry3) + z * COS(ry3) : x = xy
        projX = x * scale : projY = y * scale
        screenY = INT(projY) + (screenH / 2) : screenX = INT(projX) + rightX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor((colorIdx + 170) % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF
    NEXT i
ENDSUB


SUB Draw3DTorusDirect(pBuffer:POINTER, screenW:INT, screenH:INT, penColor:INT)
    DEF i, qx, qy:INT
    INT centerX, leftX, rightX, sideOffset
    INT screenX, screenY, colorIdx, pixelColor
    FLOAT u, v, x, y, z, xy
    FLOAT torusR1, torusR2
    FLOAT rx1, ry1, rx2, ry2, rx3, ry3
    FLOAT tx, ty, tz
    POINTER pPixel

    ' Update global rotation (used as the engine-wide base)
    rotX = rotX + 0.03
    rotY = rotY + 0.02

    ' Calculate unique rotation angles for each torus using multipliers and inversions
    rx1 = rotX : ry1 = rotY
    rx2 = -rotX * 1.3 : ry2 = rotY * 1.1
    rx3 = rotX * 0.7 : ry3 = -rotY * 1.5

    ' Proportional layout spacing
    sideOffset = (screenW * 35) / 100
    centerX = screenW / 2
    leftX   = centerX - sideOffset
    rightX  = centerX + sideOffset

    torusR1 = 95.0
    torusR2 = 38.0

    FOR i = 0 TO 199
        u = FLOAT(i % 20) * 0.314159
        v = FLOAT(i / 20) * 0.628318

        ' Pre-calculate parametric object-space coordinates
        tx = (torusR1 + torusR2 * COS(v)) * COS(u)
        ty = (torusR1 + torusR2 * COS(v)) * SIN(u)
        tz = torusR2 * SIN(v)

        colorIdx = (i + INT(phase * 40.0)) % 256

        ' --- RENDER LEFT TORUS (Direction A) ---
        x = tx : y = ty : z = tz
        xy = y * COS(rx1) - z * SIN(rx1) : z = y * SIN(rx1) + z * COS(rx1) : y = xy
        xy = x * COS(ry1) + z * SIN(ry1) : x = xy
        screenY = INT(y) + (screenH / 2)
        screenX = INT(x) + leftX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor(colorIdx % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF

        ' --- RENDER CENTER TORUS (Direction B - Inverse/Fast) ---
        x = tx : y = ty : z = tz
        xy = y * COS(rx2) - z * SIN(rx2) : z = y * SIN(rx2) + z * COS(rx2) : y = xy
        xy = x * COS(ry2) + z * SIN(ry2) : x = xy
        screenY = INT(y) + (screenH / 2)
        screenX = INT(x) + centerX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor((colorIdx + 85) % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF

        ' --- RENDER RIGHT TORUS (Direction C - Slow/Inverse Y) ---
        x = tx : y = ty : z = tz
        xy = y * COS(rx3) - z * SIN(rx3) : z = y * SIN(rx3) + z * COS(rx3) : y = xy
        xy = x * COS(ry3) + z * SIN(ry3) : x = xy
        screenY = INT(y) + (screenH / 2)
        screenX = INT(x) + rightX
        IF screenX >= 0 AND (screenX + 3) < screenW AND screenY >= 156 AND (screenY + 3) < (screenH - 160) THEN
            pixelColor = GetCycleColor((colorIdx + 170) % 256)
            FOR qy = 0 TO 3
                pPixel = pBuffer + (((screenY + qy) * screenW + screenX) * 4)
                FOR qx = 0 TO 3 : *<INT>(pPixel + (qx * 4)) = pixelColor : NEXT qx
            NEXT qy
        ENDIF
    NEXT i
ENDSUB


SUB InitGraphics()
    IF hMemDC <> 0 THEN
        SelectObject(hMemDC, hOldBmp)
        DeleteObject(hMemBmp)
        DeleteDC(hMemDC)
    ENDIF

    IF hWindowDC <> 0 THEN ReleaseDC(main_win.hwnd, hWindowDC)
    hWindowDC = GetDC(main_win.hwnd)
    SetStretchBltMode(hWindowDC, 3)          ' COLORONCOLOR
    ComputeBlitRect()
    IF g_needScale = 1 THEN PatBlt(hWindowDC, 0, 0, g_winW, g_winH, 0x00000042)     ' BLACKNESS: paints the letterbox bars

    hMemDC = CreateCompatibleDC(hWindowDC)
    
    bmpInfo.biSize = 40
    bmpInfo.biWidth = screenW
    bmpInfo.biHeight = -screenH
    bmpInfo.biPlanes = 1
    bmpInfo.biBitCount = 32
    bmpInfo.biCompression = 0

    hMemBmp = CreateDIBSection(hMemDC, &bmpInfo, 0, &pPixelBuffer, 0, 0)
    hOldBmp = SelectObject(hMemDC, hMemBmp)

   IF hPostDC <> 0 THEN
       SelectObject(hPostDC, hOldPostBmp)
       DeleteObject(hPostBmp)
       DeleteDC(hPostDC)
   ENDIF
   hPostDC = CreateCompatibleDC(hWindowDC)
   hPostBmp = CreateDIBSection(hPostDC, &bmpInfo, 0, &pPostBuffer, 0, 0)
   hOldPostBmp = SelectObject(hPostDC, hPostBmp)

    ' Initialize these right after allocating/creating your DIB Section:
    g_bufferByteSize = screenW * screenH * 4
    g_bufferDwordCount = screenW * screenH    

    IF pCopperBuffer <> 0 THEN FREEMEM pCopperBuffer
    ALLOCMEM(pCopperBuffer, screenW * screenH, 4)

    IF pTrailBuffer <> 0 THEN FREEMEM pTrailBuffer
    ALLOCMEM(pTrailBuffer, screenW * screenH, 4)
    FastClearBuffer(pTrailBuffer, screenW * screenH * 4)

    ' Transition Buffer
    IF pTransitionBuffer <> 0 THEN FREEMEM pTransitionBuffer
    ALLOCMEM(pTransitionBuffer, screenW * screenH, 4)
    FastClearBuffer(pTransitionBuffer, screenW * screenH * 4)

    ' Safe Guard-Banded HyperStars Layer Buffer Allocation
    IF g_pHyperStarsLayer <> 0 THEN FREEMEM g_pHyperStarsLayer
    ALLOCMEM(g_pHyperStarsLayer, screenW * (screenH + 4), 4)
    FastClearBuffer(g_pHyperStarsLayer, screenW * (screenH + 4) * 4)
ENDSUB

SUB FastClearBuffer(pBuf:POINTER, nBytes:INT)
    g_pAsmDst = pBuf
    g_asmNumBytes = nBytes

    _asm
        push edi
        mov edi, [g_pAsmDst]
        mov ecx, [g_asmNumBytes]
        shr ecx, 2
        xor eax, eax
        rep stosd
        pop edi
    _endasm
ENDSUB

SUB AdditiveBlendASM(pTargetBuf:POINTER, pSrcBuf:POINTER, numPix:INT)
    g_pAsmDst = pTargetBuf
    g_pAsmSrc = pSrcBuf
    g_asmCount = numPix >> 2
    g_asmPixelColor = 0x00FFFFFF

    _asm
        push esi
        push edi

        mov edi, [g_pAsmDst]
        mov esi, [g_pAsmSrc]
        mov ecx, [g_asmCount]

        test edi, edi
        jz blend_exit
        test esi, esi
        jz blend_exit
        test ecx, ecx
        jz blend_exit

        movd xmm2, [g_asmPixelColor]
        pshufd xmm2, xmm2, 0

    blend_loop:
        movdqu xmm0, [edi]
        movdqu xmm1, [esi]

        pand xmm0, xmm2
        pand xmm1, xmm2

        paddusb xmm0, xmm1

        movdqu [edi], xmm0

        add edi, 16
        add esi, 16
        dec ecx
        jnz blend_loop

    blend_exit:
        pop edi
        pop esi
    _endasm
ENDSUB

SUB DrawBuffered()
    IF pPixelBuffer = 0 OR pCopperBuffer = 0 THEN RETURN

    ' 1. Update Beat Envelope
    UpdateAudioPulse()

    phase = phase + 0.06 

    ' Retain phase values between frame calls
    STATIC double gadd, gadd2
    gadd = phase * 2.5          ' Advance primary wave angle
    gadd2 = phase * 1.3         ' Advance secondary wave angle

	 ' Generate haiku once upon entering target overlay modes (10 or 17)
    IF (current_overlay = 10 OR current_overlay = 17) THEN
        IF g_HaikuGenerated = 0 THEN
            g_HaikuLine1 = BuildHaikuLine(5)
            g_HaikuLine2 = BuildHaikuLine(7)
            g_HaikuLine3 = BuildHaikuLine(5)
            g_HaikuGenerated = 1  ' Lock state across frames
        ENDIF
    ELSE
        ' Reset the lock flag ONLY when leaving the haiku overlays
        g_HaikuGenerated = 0
    ENDIF
    frame_count = frame_count + 1
    IF frame_count >= 456 THEN
        frame_count = 0

        ' 1. Snapshot current rendered screen into pTransitionBuffer (Fast x86 inline copy)
        FastCopyBuffer(pTransitionBuffer, pPixelBuffer, g_bufferDwordCount)

        ' 2. Begin Transition State
        g_isTransitioning = 1
        g_transitionFrame = 0

        ' 3. Advance to next overlay
        current_overlay = (current_overlay + 1) % 21
        g_overlayEpoch = g_overlayEpoch + 1
    ENDIF

    ' --- 1. TRAIL DECAY PASS ---
    SELECT current_overlay
        CASE 2:  ' Moiré interference
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 200)
        CASE 3:  ' Super Rose Curve
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 215)
        CASE 4:  ' Spinning Cube
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 192)
        CASE 5:  ' Fireworks
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 215)
        CASE 6:  ' Dotted Sphere
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 160)
        CASE 7:  ' 3D Torus
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 160)
        CASE 8:  ' Rotozoom
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 110)
        CASE 10: ' Metaballs
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 185)
        CASE 12: ' Wormhole
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 110)
        CASE 15: ' Infernal Wireframe
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 215)
        CASE 16: ' Metaball Moiré Interference
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 185)
        CASE 17: ' Lissajous Bob Snake
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 160)
        CASE 18: ' Markov Haïku Generator
            ApplyTrailDecaySSE2(pPixelBuffer, screenW * screenH, 185)
        DEFAULT:
            FastClearBuffer(pPixelBuffer, screenW * screenH * 4)
            FastClearBuffer(pCopperBuffer, screenW * screenH * 4)
    ENDSELECT

    INT dynamicColor = GetCycleColor(INT(phase * 40.0) & 255)

    ' --- 2. EFFECT RENDERING PASS ---
    SELECT current_overlay
        CASE 0:  ' [0] Rasterbar Pixel Art Logo Composite
            DrawRasterbarLogoComposite(pPixelBuffer, screenW, screenH)
        CASE 1:  ' [1] Gravity Web
            DrawGravityWebDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 2:  ' [2] Moiré Interference
            DrawMoireInterferenceDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 3:  ' [3] Super Rose Curve
            DrawSuperRoseCurveDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 4:  ' [4] Spinning Cube
            DrawSpinningCubeDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 5:  ' [5] Fireworks
            DrawFireworksDirect(pPixelBuffer, screenW, screenH)
            DrawCubeEffectDirectTransparent4X(pPixelBuffer, screenW, screenH)
        CASE 6:  ' [6] Dotted Sphere
            DrawDottedSphereDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 7:  ' [7] Rotozoom
            DrawRotozoomDirect(pPixelBuffer, screenW, screenH)
        CASE 8:  ' [8] 3D Torus
            Draw3DTorusDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 9:  ' [9] Wave Ripples
            DrawWaveRipplesDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 10: ' [10] Metaballs
            DrawMetaballsEffectDirect(pPixelBuffer, screenW, screenH)
        CASE 11: ' [11] Plasma Effect
            DrawPlasmaEffectDirect(pPixelBuffer, screenW, screenH)
        CASE 12: ' [12] Dotted Wormhole
            DrawDottedWormholeDirect(pPixelBuffer, screenW, screenH)
        CASE 13: ' [13] 3D Undulating Mesh Grid
            Draw3DGridMeshDirect(pPixelBuffer, screenW, screenH, 0x0000FFFF)
        CASE 14: ' [14] 3D HyperStars Tunnel
            DrawHyperStarsDirect(pPixelBuffer, screenW, screenH)
        CASE 15: ' [15] Infernal Wireframe
            DrawFireEffectDirect(pPixelBuffer, screenW, screenH)
            FLOAT beatScale = 1.0 + (g_beatPulse * 0.25)
            DrawSpinningCubeDirect(pPixelBuffer, screenW, screenH, dynamicColor)            
            DrawCubeEffectDirectTransparent4X(pPixelBuffer, screenW, screenH)
        CASE 16: ' [16] Metaball Moiré Interference
            DrawMetaballsEffectDirect(pPixelBuffer, screenW, screenH)
            DrawMoireInterferenceDirect(pPixelBuffer, screenW, screenH, dynamicColor)
        CASE 17: ' [17] Lissajous Bob Snake
            DrawBobGridComposite(pPixelBuffer, screenW, screenH)
        CASE 18: ' [18] Markov Haiku
				DrawIsometricFlyoverDirect(pPixelBuffer, screenW, screenH, phase)
				' Render 5-7-5 Strict Demoscene Haiku Overlay
				RenderHaikuOverlayDirect(pPixelBuffer, screenW, screenH, phase)
        CASE 19: ' [19] Fly-In Outro
            UpdateAndDrawFlyInOutroDirect(pPixelBuffer, screenW, screenH)
        CASE 20: ' [20] TV Static Noise
            DrawTVStaticDirect(pPixelBuffer, screenW, screenH)
    ENDSELECT

	 ' --- COMPOSITING & OVERLAYS ---
    AdditiveBlendASM(pPixelBuffer, pCopperBuffer, screenW * screenH)
    UpdateAndDrawStarfieldDirect(pPixelBuffer, screenW, screenH)
    SW_RenderBorders(phase * 15.0, pPixelBuffer, screenW, screenH)
    DrawAnimatedTitleDirect(pPixelBuffer, screenW, screenH, effectTechSpecs[current_overlay], 80)
    DrawBouncingOverlayNameDirect(pPixelBuffer, screenW, screenH)
    Render3DVectorScroller(pPixelBuffer, screenW, screenH, 0x00FFDD)

    ' --- FAST CAROUSEL CROSS-FADE PASS ---
    IF g_isTransitioning = 1 THEN
        g_transitionFrame = g_transitionFrame + 1
        
        ' Fast integer-based alpha attenuation (0 to 255)
        INT fadeAlpha
        fadeAlpha = 255 - ((g_transitionFrame * 255) / TRANSITION_DURATION)

        IF fadeAlpha > 0 THEN
            INT vpOffset = 151 * screenW * 4
            INT vpPixels = screenW * (screenH - 150 - 151)
            AlphaBlendBuffersASM(pPixelBuffer + vpOffset, pTransitionBuffer + vpOffset, vpPixels, fadeAlpha)
        ELSE
            g_isTransitioning = 0
        ENDIF
    ENDIF
	' --- FINAL SCREEN FLIP ---
   POINTER pShow
   INT hShowDC
   pShow = pPixelBuffer
   hShowDC = hMemDC
   IF g_postFX = 1 AND pPostBuffer <> NULL THEN
       ApplyPostFX(pPixelBuffer, pPostBuffer, screenW, screenH)
       pShow = pPostBuffer
       hShowDC = hPostDC
   ENDIF
   IF g_needScale = 0 THEN
       SetDIBitsToDevice(hWindowDC, 0, 0, screenW, screenH, 0, 0, 0, screenH, pShow, &bmpInfo, 0)
   ELSE
       StretchBlt(hWindowDC, g_dstX, g_dstY, g_dstW, g_dstH, hShowDC, 0, 0, screenW, screenH, 0x00CC0020)
   ENDIF
ENDSUB

SUB SetStroke(charIdx:INT, strokeIdx:INT, x1:INT, y1:INT, x2:INT, y2:INT)
    INT base = strokeIdx * 4
    fontData[charIdx, base]     = x1
    fontData[charIdx, base + 1] = y1
    fontData[charIdx, base + 2] = x2
    fontData[charIdx, base + 3] = y2
ENDSUB

SUB EndGlyph(charIdx:INT, strokeIdx:INT)
    INT base = strokeIdx * 4
    fontData[charIdx, base]     = -1
    fontData[charIdx, base + 1] = -1
    fontData[charIdx, base + 2] = -1
    fontData[charIdx, base + 3] = -1
ENDSUB

SUB InitVectorFontTable()
    SetStroke(0, 0, 0, 16, 8, 0): SetStroke(0, 1, 8, 0, 16, 16): SetStroke(0, 2, 4, 9, 12, 9): EndGlyph(0, 3)
    SetStroke(1, 0, 0, 0, 0, 16): SetStroke(1, 1, 0, 0, 10, 0): SetStroke(1, 2, 10, 0, 12, 4)
    SetStroke(1, 3, 12, 4, 10, 8): SetStroke(1, 4, 10, 8, 0, 8): SetStroke(1, 5, 10, 8, 12, 12)
    SetStroke(1, 6, 12, 12, 10, 16): SetStroke(1, 7, 10, 16, 0, 16): EndGlyph(1, 8)
    SetStroke(2, 0, 14, 3, 4, 0): SetStroke(2, 1, 4, 0, 0, 4): SetStroke(2, 2, 0, 4, 0, 12)
    SetStroke(2, 3, 0, 12, 4, 16): SetStroke(2, 4, 4, 16, 14, 13): EndGlyph(2, 5)
    SetStroke(3, 0, 0, 0, 0, 16): SetStroke(3, 1, 0, 0, 10, 0): SetStroke(3, 2, 10, 0, 16, 6)
    SetStroke(3, 3, 16, 6, 16, 10): SetStroke(3, 4, 16, 10, 10, 16): SetStroke(3, 5, 10, 16, 0, 16): EndGlyph(3, 6)
